rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Igual a la regla publicada desde la consola: lee cualquier usuario
    // autenticado y solo el admin sube fotos de objetos encontrados.
    match /foundItems/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isAdmin()
        && validImage();
    }

    // Dueño del reporte cuyo id es el nombre del archivo sin '.jpg'.
    function lostReportOwner(fileName) {
      return firestore.get(/databases/(default)/documents/lostReports/$(fileName.split('[.]')[0])).data.ownerUid;
    }

    // Foto del reporte de objeto perdido: lostReports/{reportId}.jpg.
    // El reporte debe existir antes de subir la foto, porque así se sabe quién
    // es el dueño. La ven el dueño y el admin, igual que el reporte en Firestore.
    match /lostReports/{fileName} {
      allow read: if request.auth != null
        && fileName.matches('^[A-Za-z0-9_-]+[.]jpg$')
        && (isAdmin() || lostReportOwner(fileName) == request.auth.uid);
      allow create, update: if request.auth != null
        && fileName.matches('^[A-Za-z0-9_-]+[.]jpg$')
        && lostReportOwner(fileName) == request.auth.uid
        && validImage();
      allow delete: if false;
    }
  }
}
